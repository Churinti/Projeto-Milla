# Modelo de configuração do `docker compose`.
#   cp .env.example .env     (PowerShell: Copy-Item .env.example .env)
#
# MILLA_TOKEN: senha da API. Precisa de 16+ caracteres e só aceita
# [A-Za-z0-9._~-] (ela viaja como subprotocolo no WebSocket). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Deixando vazio, o contêiner gera um na inicialização e imprime no log.
MILLA_TOKEN=

# Modelo do Ollama baixado na primeira execução (alguns GB). Precisa ser o
# mesmo nome que o `ollama list` mostra.
MILLA_MODELO=qwen2.5:7b-instruct-q4_K_M

# Porta publicada no host (o painel fica em http://localhost:<porta>).
MILLA_PORTA_PUBLICA=8000
